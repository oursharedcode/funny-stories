# Required for image generation. Deploy the Cloudflare Worker first
# (see README -> Deploying the Cloudflare Worker).
CLOUDFLARE_WORKER_URL=
CLOUDFLARE_WORKER_SECRET=

# Optional: if set, the end screen shows a "Support this server" button linking here.
# Donations go to YOU (the operator), not the upstream author. Leave unset for no button.
DEPLOYER_DONATE_URL=

# Optional: concurrent room ceiling per process. Default 500 if unset.
# MAX_ROOMS=500

# Optional: daily Cloudflare AI image ceiling per server process. Default 25
# if unset. Protects the Workers AI free tier — see docs/Cloudflare_usage.md.
# MAX_IMAGES_PER_DAY=25

# Optional: server port. Default 3000 if unset.
# PORT=3000
